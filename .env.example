# Copy to .env.local (never commit it).

# --- Supabase (PostgreSQL + pgvector, Auth, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: safe in the browser (RLS protects the data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: SERVER ONLY (bypasses RLS). Used only to delete accounts rejected by the domain check.
SUPABASE_SECRET_KEY=sb_secret_...
# Postgres connection string, used only by `npm run db:migrate` (URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Access ---
# The only email domain allowed to sign in. Used by the app AND written into the database by db:migrate.
ALLOWED_EMAIL_DOMAIN=psgtech.ac.in

# --- Gemini (chat, explanations, study tools, embeddings). Optional: local fallbacks exist. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy (429/5xx) or retired (404)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Notebook embeddings ---
# auto = Gemini when GEMINI_API_KEY is set, otherwise a local model (all-MiniLM-L6-v2) running on the server
EMBEDDING_PROVIDER=auto
# Local embedding model cache
NOTEBOOK_DATA_DIR=.data
# Optional: minimum similarity for a passage to count as relevant (defaults: gemini 0.5, local 0.3)
RAG_MIN_SCORE=
